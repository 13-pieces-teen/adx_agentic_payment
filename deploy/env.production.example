# Copy with deploy/scripts/generate-env.sh; never commit deploy/.env.
#
# domain: Caddy obtains and renews a normal public certificate automatically.
# ip:     Certbot obtains a 160-hour IP certificate; a systemd timer renews it.
# http:   smoke tests only; remote Connectors must not use this mode.
ADX_TLS_MODE=domain
ADX_PUBLIC_HOST=arena.example.com
ADX_PUBLIC_APP_URL=https://arena.example.com
ADX_CADDY_CONFIG=Caddyfile.domain

POSTGRES_DB=adx
POSTGRES_USER=adx
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
ADX_API_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_HOSTED_WORKER_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_ARENA_CORE_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_CREDENTIAL_CONTROLLER_DATABASE_PASSWORD=replace-with-a-distinct-random-value

ADX_CONNECTOR_SESSION_SECRET=replace-with-at-least-32-random-characters
# Store only a 64-character SHA-256 hex digest. Never store the plaintext invite.
ADX_BOOTSTRAP_INVITE_HASH=replace-with-64-lowercase-hex-characters
ADX_CONNECTOR_SESSION_TTL_SECONDS=604800
ADX_CONNECTOR_COOKIE_NAME=adx_session
ADX_CONNECTOR_COOKIE_SECURE=true
ADX_CONNECTOR_AUTH_RATE_LIMIT_ATTEMPTS=10
ADX_CONNECTOR_PAIRING_RATE_LIMIT_ATTEMPTS=60
ADX_CONNECTOR_RATE_LIMIT_WINDOW_SECONDS=60
ADX_CONNECTOR_MAX_PENDING_PAIRINGS=500
ADX_ENV=production
ADX_API_MAX_CONCURRENCY=256

# Hosted Agent production profile is fail-closed by default.
ADX_HOSTED_AGENTS_ENABLED=false
ADX_ENABLE_HOSTED_RUNTIME=false
ADX_HOSTED_FINGERPRINT_PEPPER_B64=replace-with-32-or-more-random-bytes-in-base64
ADX_HOSTED_FINGERPRINT_PEPPER_VERSION=1
ADX_TENCENT_SSM_REGION=ap-guangzhou
ADX_TENCENT_SSM_RECOVERY_WINDOW_DAYS=0
ADX_TENCENT_SSM_IAM_VERIFIED=false
# Prefer role/workload identity. If static credentials are unavoidable, use
# three different CAM users and never reuse writer/reader/controller keys.
ADX_TENCENT_SSM_WRITER_SECRET_ID=
ADX_TENCENT_SSM_WRITER_SECRET_KEY=
ADX_TENCENT_SSM_WRITER_TOKEN=
ADX_TENCENT_SSM_READER_SECRET_ID=
ADX_TENCENT_SSM_READER_SECRET_KEY=
ADX_TENCENT_SSM_READER_TOKEN=
ADX_TENCENT_SSM_CONTROLLER_SECRET_ID=
ADX_TENCENT_SSM_CONTROLLER_SECRET_KEY=
ADX_TENCENT_SSM_CONTROLLER_TOKEN=
ADX_OPENAI_COMPATIBLE_ENDPOINT=
ADX_OPENAI_COMPATIBLE_MODELS=
ADX_HOSTED_WORKER_LEASE_SECONDS=600
ADX_HOSTED_WORKER_POLL_SECONDS=1
ADX_HOSTED_WORKER_TASK_CONCURRENCY=5

# Arena Worker has read-only chain access and no signer credentials.
ADX_ENABLE_ARENA_WORKER=false
ADX_ARENA_SETTLEMENT_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
ADX_ARENA_SETTLEMENT_BLOCKSCOUT_URL=https://testnet.blockscout.injective.network/api/v2
ADX_ARENA_WORKER_LEASE_SECONDS=600
ADX_ARENA_WORKER_POLL_SECONDS=0.25
ADX_ARENA_ORCHESTRATION_POLL_SECONDS=0.25
ADX_ARENA_FINALIZER_POLL_SECONDS=1
ADX_SETTLEMENT_RECOVERY_POLL_SECONDS=3

# Recommended for certificate expiry/account notifications in IP mode.
ADX_ACME_EMAIL=

TZ=Asia/Shanghai
ADX_BACKUP_DIR=/var/backups/adx
ADX_BACKUP_RETENTION_DAYS=14
ADX_BUILD_CONNECTOR_ARTIFACTS=true
