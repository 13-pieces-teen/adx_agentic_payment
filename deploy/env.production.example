# Copy with deploy/scripts/generate-env.sh; never commit deploy/.env.
#
# domain: Caddy obtains and renews a normal public certificate automatically.
# ip:     Certbot obtains a 160-hour IP certificate; a systemd timer renews it.
# http:   smoke tests only; remote Connectors must not use this mode.
ADX_TLS_MODE=domain
ADX_PUBLIC_HOST=arena.example.com
ADX_PUBLIC_APP_URL=https://arena.example.com
ADX_PUBLIC_API_URL=https://api.arena.example.com
ADX_CADDY_CONFIG=Caddyfile.domain

POSTGRES_DB=adx
POSTGRES_USER=adx
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
POSTGRES_MAX_CONNECTIONS=120
ADX_API_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_HOSTED_WORKER_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_ARENA_CORE_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_SETTLEMENT_DATABASE_PASSWORD=replace-with-a-distinct-random-value
ADX_CREDENTIAL_CONTROLLER_DATABASE_PASSWORD=replace-with-a-distinct-random-value

ADX_CONNECTOR_SESSION_SECRET=replace-with-at-least-32-random-characters
ADX_SETTLEMENT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
ADX_SETTLEMENT_SERVICE_URL=http://settlement-worker:8790
# GitHub OAuth App callback. It stays on the API origin so the state cookie
# written at authorization start is returned to the same host on callback.
# Register https://api.arena402.com/api/auth/github/callback in GitHub.
ADX_GITHUB_OAUTH_CLIENT_ID=
ADX_GITHUB_OAUTH_CLIENT_SECRET=
ADX_GITHUB_OAUTH_CALLBACK_BASE_URL=https://api.arena402.com
ADX_GITHUB_OAUTH_STATE_TTL_SECONDS=600
# Optional server-side token relay for regions that cannot reach github.com.
ADX_GITHUB_OAUTH_RELAY_URL=https://www.arena402.com/api/internal/github/oauth
# Store only a 64-character SHA-256 hex digest. Never store the plaintext invite.
ADX_BOOTSTRAP_INVITE_HASH=replace-with-64-lowercase-hex-characters
ADX_CONNECTOR_SESSION_TTL_SECONDS=604800
ADX_CONNECTOR_COOKIE_NAME=adx_session
ADX_CONNECTOR_COOKIE_SECURE=true
ADX_CONNECTOR_AUTH_RATE_LIMIT_ATTEMPTS=10
ADX_CONNECTOR_PAIRING_RATE_LIMIT_ATTEMPTS=60
ADX_CONNECTOR_RATE_LIMIT_WINDOW_SECONDS=60
ADX_CONNECTOR_MAX_PENDING_PAIRINGS=500
ADX_ENV=production
ADX_API_MAX_CONCURRENCY=64

# Hosted Agent production profile is fail-closed by default.
ADX_HOSTED_AGENTS_ENABLED=false
ADX_ARENA_CORE_ENABLED=true
ADX_ARENA_PAYMENTS_ENABLED=true
# Founding 402 eligibility/read API. Enable only after migration 035 and the
# public wallet inventory import have been reviewed.
ADX_ARENA_MEMORIAL_ENABLED=false
ADX_ENABLE_MEMORIAL_MINTER=false
ADX_MEMORIAL_CONTRACT_ADDRESS=0x17d9cd66b9bc7b6d12fb3c60cbf81b2f814c2364
ADX_MEMORIAL_MINTER_POLL_SECONDS=2
ADX_MEMORIAL_MINTER_BATCH_SIZE=1
ADX_ENABLE_GAMECOIN_PROVISIONER=false
ADX_GAMECOIN_OWNER_WALLET_INDEX=1
ADX_GAMECOIN_PROVISIONER_POLL_SECONDS=2
ADX_GAMECOIN_REQUIRED_CONFIRMATIONS=2
# Four relay shards use independent EOA wallet rows and bearer credentials.
ADX_X402_FACILITATOR_ID=arena402-injective-testnet-4-shard
ADX_X402_FACILITATOR_SHARD_COUNT=4
ADX_X402_FACILITATOR_1_URL=http://arena-facilitator-1:4021
ADX_X402_FACILITATOR_1_ID=arena402-injective-testnet-1
ADX_X402_FACILITATOR_1_AUTHORIZATION=Bearer replace-with-shard-1-random-token
ADX_X402_FACILITATOR_1_BEARER_TOKEN=replace-with-shard-1-random-token
ADX_FACILITATOR_1_WALLET_INDEX=1
ADX_X402_FACILITATOR_2_URL=http://arena-facilitator-2:4021
ADX_X402_FACILITATOR_2_ID=arena402-injective-testnet-2
ADX_X402_FACILITATOR_2_AUTHORIZATION=Bearer replace-with-shard-2-random-token
ADX_X402_FACILITATOR_2_BEARER_TOKEN=replace-with-shard-2-random-token
ADX_FACILITATOR_2_WALLET_INDEX=2
ADX_X402_FACILITATOR_3_URL=http://arena-facilitator-3:4021
ADX_X402_FACILITATOR_3_ID=arena402-injective-testnet-3
ADX_X402_FACILITATOR_3_AUTHORIZATION=Bearer replace-with-shard-3-random-token
ADX_X402_FACILITATOR_3_BEARER_TOKEN=replace-with-shard-3-random-token
ADX_FACILITATOR_3_WALLET_INDEX=3
ADX_X402_FACILITATOR_4_URL=http://arena-facilitator-4:4021
ADX_X402_FACILITATOR_4_ID=arena402-injective-testnet-4
ADX_X402_FACILITATOR_4_AUTHORIZATION=Bearer replace-with-shard-4-random-token
ADX_X402_FACILITATOR_4_BEARER_TOKEN=replace-with-shard-4-random-token
ADX_FACILITATOR_4_WALLET_INDEX=4
# Keep the four-row CSV outside the repository, owned by UID 10001, chmod 0600.
ADX_FACILITATOR_CSV_HOST_PATH=/opt/arena402/secrets/arena402-facilitators.csv
# Comma-separated immutable GitHub numeric subjects allowed to read the
# wallet/mandate/settlement operations dashboard API.
ADX_ARENA_ADMIN_GITHUB_SUBJECTS=

# Automatic A2A settlement is opt-in until the testnet signer and facilitator
# are configured. Once enabled, PaymentMandates replace per-payment approval.
ADX_ARENA_AUTOMATIC_PAYMENTS_ENABLED=false
# Optional first-live-payment canary. When set, the Settlement Worker scans
# only this immutable SettlementIntent; clear it only after canary acceptance.
ADX_SETTLEMENT_INTENT_ID=
ADX_ENABLE_SETTLEMENT_WORKER=false
ADX_ENABLE_TESTNET_SIGNER=false
ADX_ENABLE_TESTNET_FACILITATOR=false
ADX_SETTLEMENT_WORKER_POLL_SECONDS=0.5
ADX_SETTLEMENT_WORKER_CONCURRENCY=4
ADX_SETTLEMENT_LEASE_SECONDS=60
ADX_WALLET_SIGNER_URL=http://wallet-signer:8787
ADX_WALLET_SIGNER_TOKEN=replace-with-at-least-32-random-characters
ADX_WALLET_SIGNER_ALLOWED_CHAIN_ID=1439
ADX_WALLET_SIGNER_DATABASE_PASSWORD=replace-with-random-database-password
ADX_WALLET_IMPORTER_DATABASE_PASSWORD=replace-with-different-random-database-password
# PostgreSQL stores only per-wallet AES-GCM ciphertext. Keep exactly 32 random
# bytes in wallet-master.key, owned by container UID 10001 and chmod 0400.
ADX_WALLET_SECRET_DIR_HOST_PATH=/etc/arena402/wallet-secrets
ADX_WALLET_MASTER_KEY_VERSION=1
# One-time import source for the manual wallet-admin profile. It is never
# mounted into the long-running signer service.
ADX_WALLET_IMPORT_CSV_HOST_PATH=/opt/arena402/import/agent-wallets.csv
# Rotation profile defaults. Keep both files until the new signer passes health
# and a synthetic signature check.
ADX_WALLET_OLD_MASTER_KEY_FILENAME=wallet-master.key
ADX_WALLET_NEW_MASTER_KEY_FILENAME=wallet-master-next.key
ADX_WALLET_OLD_MASTER_KEY_VERSION=1
ADX_WALLET_NEW_MASTER_KEY_VERSION=2
ADX_ENABLE_HOSTED_RUNTIME=false
ADX_HOSTED_FINGERPRINT_PEPPER_B64=replace-with-32-or-more-random-bytes-in-base64
ADX_HOSTED_FINGERPRINT_PEPPER_VERSION=1
# Single-host beta: PostgreSQL stores AES-256-GCM ciphertext only. This
# directory contains a raw 32-byte hosted-master.key owned by container UID
# 10001. Set the verified flag only after the path/permissions are checked.
ADX_HOSTED_SECRET_BACKEND=postgres_aesgcm
ADX_HOSTED_CREDENTIAL_BACKEND_VERIFIED=false
ADX_HOSTED_SECRET_DIR_HOST_PATH=/etc/arena402/secrets
ADX_HOSTED_MASTER_KEY_VERSION=1
# Optional paid alternative:
ADX_TENCENT_SSM_REGION=ap-guangzhou
ADX_TENCENT_SSM_RECOVERY_WINDOW_DAYS=0
ADX_TENCENT_SSM_IAM_VERIFIED=false
# Prefer role/workload identity. If static credentials are unavoidable, use
# three different CAM users and never reuse writer/reader/controller keys.
ADX_TENCENT_SSM_WRITER_SECRET_ID=
ADX_TENCENT_SSM_WRITER_SECRET_KEY=
ADX_TENCENT_SSM_WRITER_TOKEN=
ADX_TENCENT_SSM_READER_SECRET_ID=
ADX_TENCENT_SSM_READER_SECRET_KEY=
ADX_TENCENT_SSM_READER_TOKEN=
ADX_TENCENT_SSM_CONTROLLER_SECRET_ID=
ADX_TENCENT_SSM_CONTROLLER_SECRET_KEY=
ADX_TENCENT_SSM_CONTROLLER_TOKEN=
ADX_OPENAI_COMPATIBLE_ENDPOINT=
ADX_OPENAI_COMPATIBLE_MODELS=
ADX_HOSTED_WORKER_LEASE_SECONDS=600
ADX_HOSTED_WORKER_POLL_SECONDS=1
ADX_HOSTED_WORKER_REPLICAS=4
ADX_HOSTED_WORKER_TASK_CONCURRENCY=25

# Arena Worker has read-only chain access and no signer credentials.
ADX_ENABLE_ARENA_WORKER=true
ADX_ARENA_SETTLEMENT_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
ADX_ARENA_SETTLEMENT_BLOCKSCOUT_URL=https://testnet.blockscout.injective.network/api/v2
ADX_WALLET_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
ADX_WALLET_EXPLORER_URL=https://testnet.blockscout.injective.network
ADX_ARENA_EXPLORER_TX_URL_TEMPLATE=https://testnet.blockscout.injective.network/tx/{txHash}
# Configure these only with the deployed Arena 402 token contract addresses.
ADX_ARENA402_G_TOKEN_ADDRESS=0xBF7B7268CE82d92BaC7a95a741F4003FE84e1884
ADX_ARENA402_G_TOKEN_DECIMALS=6
ADX_ARENA402_M_TOKEN_ADDRESS=
ADX_ARENA402_M_TOKEN_DECIMALS=6
ADX_ARENA_WORKER_LEASE_SECONDS=600
ADX_ARENA_WORKER_POLL_SECONDS=0.25
ADX_ARENA_ORCHESTRATION_POLL_SECONDS=0.25
ADX_ARENA_FINALIZER_POLL_SECONDS=1
ADX_SETTLEMENT_RECOVERY_POLL_SECONDS=3
ADX_CURRENT_GAME_POLL_SECONDS=1
ADX_CURRENT_GAME_ROUND_COUNT=5
ADX_CURRENT_GAME_START_THRESHOLD=10
ADX_CURRENT_GAME_MAX_PARTICIPANTS=100
ADX_CURRENT_GAME_OFFICIAL_FILL_AFTER_SECONDS=300
ADX_CURRENT_GAME_ACTION_TIMEOUT_MS=90000
ADX_CURRENT_GAME_MAX_NEGOTIATION_TURNS=3
ADX_CURRENT_GAME_CHAIN_ID=1439
ADX_CURRENT_GAME_TOKEN_ADDRESS=0xBF7B7268CE82d92BaC7a95a741F4003FE84e1884
ADX_CURRENT_GAME_TOKEN_SYMBOL=arena402-g
ADX_CURRENT_GAME_TOKEN_DECIMALS=6
ADX_CURRENT_GAME_TOKEN_EIP712_NAME=Arena 402 Gold
ADX_CURRENT_GAME_TOKEN_EIP712_VERSION=1
ADX_CURRENT_GAME_REQUIRED_CONFIRMATIONS=2

# Recommended for certificate expiry/account notifications in IP mode.
ADX_ACME_EMAIL=

TZ=Asia/Shanghai
ADX_BACKUP_DIR=/var/backups/adx
ADX_BACKUP_RETENTION_DAYS=14
ADX_BUILD_CONNECTOR_ARTIFACTS=true
