# syntax=docker/dockerfile:1.7

FROM python:3.13-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64 AS vault-deps

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements/litellm-vault.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
      --require-hashes \
      --target /opt/arena-vault-packages \
      --requirement /tmp/requirements.txt

FROM ghcr.io/berriai/litellm-non_root:v1.89.4@sha256:2cf7711f9e96f9b2b3f4a2ba9eeaa39ab229020983b85e6f6723d8827b4df209

USER root

COPY --from=vault-deps --chown=10001:10001 \
  /opt/arena-vault-packages /app/.venv/lib/python3.13/site-packages
COPY --chown=10001:10001 arena_agent_contracts /app/arena_agent_contracts
COPY --chown=10001:10001 arena_core /app/arena_core
COPY --chown=10001:10001 db_pool_config.py /app/db_pool_config.py
COPY --chown=10001:10001 hosted_agent_runtime /app/hosted_agent_runtime
COPY --chown=10001:10001 scripts/run_official_litellm.py \
  /app/scripts/run_official_litellm.py

USER 10001:10001

ENTRYPOINT ["python", "-m", "scripts.run_official_litellm"]
CMD ["--manifest-file", "/run/official-litellm/manifest.json", "--port", "4000"]
