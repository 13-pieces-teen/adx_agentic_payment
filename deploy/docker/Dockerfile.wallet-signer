# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

RUN groupadd --gid 10001 arena \
    && useradd --uid 10001 --gid arena --create-home --home-dir /home/arena arena

COPY --chown=arena:arena agent-arena/settlement/sdk/package.json ./package.json
COPY --chown=arena:arena agent-arena/settlement/sdk/package-lock.json ./package-lock.json
RUN --mount=type=cache,target=/root/.npm npm ci --include=dev

COPY --chown=arena:arena agent-arena/settlement/sdk/src ./src
COPY --chown=arena:arena agent-arena/settlement/sdk/scripts/serve-wallet-signer.ts ./scripts/serve-wallet-signer.ts

USER arena

EXPOSE 8787

CMD ["npm", "run", "signer:serve"]
