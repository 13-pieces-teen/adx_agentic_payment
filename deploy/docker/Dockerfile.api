# syntax=docker/dockerfile:1.7

FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --gid 10001 adx \
    && useradd --uid 10001 --gid adx --create-home --home-dir /home/adx adx

COPY requirements/production.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --require-hashes --requirement /tmp/requirements.txt

COPY --chown=adx:adx connector_gateway ./connector_gateway
COPY --chown=adx:adx arena_agent_contracts ./arena_agent_contracts
COPY --chown=adx:adx arena_core ./arena_core
COPY --chown=adx:adx arena_game ./arena_game
COPY --chown=adx:adx arena_payments ./arena_payments
COPY --chown=adx:adx hosted_agent_control_plane ./hosted_agent_control_plane
COPY --chown=adx:adx hosted_agent_runtime ./hosted_agent_runtime
COPY --chown=adx:adx web ./web
COPY --chown=adx:adx db ./db
COPY --chown=adx:adx deploy/scripts/api-entrypoint.sh ./deploy/scripts/api-entrypoint.sh
COPY --chown=adx:adx deploy/scripts/migrate.py ./deploy/scripts/migrate.py
COPY --chown=adx:adx deploy/scripts/provision_db_roles.py ./deploy/scripts/provision_db_roles.py
COPY --chown=adx:adx deploy/scripts/import_wallet_inventory.py ./deploy/scripts/import_wallet_inventory.py
RUN chmod 0555 /app/deploy/scripts/api-entrypoint.sh

USER adx

EXPOSE 8000

ENTRYPOINT ["/app/deploy/scripts/api-entrypoint.sh"]
