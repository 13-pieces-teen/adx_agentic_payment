{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2 h3
	}
}

{$ADX_PUBLIC_HOST} {
	encode zstd gzip

	log {
		output stdout
		format filter {
			request>uri replace REDACTED
			request>headers delete
			resp_headers delete
			wrap json
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	request_body {
		max_size 10MB
	}

	handle_path /downloads/* {
		root * /srv/downloads
		header Cache-Control "public, max-age=300"
		file_server
	}

	@connectorWss path /api/connectors/ws
	handle @connectorWss {
		reverse_proxy connector-wss:8000 {
			health_uri /api/ready
			health_interval 30s
			health_timeout 5s
		}
	}

	@connector path /api/connectors* /api/auth* /api/v1/admin/current-game /api/v1/admin/current-game/matchmaking /mcp
	handle @connector {
		reverse_proxy connector-api:8000 {
			health_uri /api/ready
			health_interval 30s
			health_timeout 5s
		}
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8000 {
			health_uri /api/ready
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		redir {$ADX_PUBLIC_APP_URL}{uri} permanent
	}
}
