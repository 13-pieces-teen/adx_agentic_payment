{
	admin 127.0.0.1:2019
}

http://{$ADX_PUBLIC_HOST} {
	log {
		output stdout
		format filter {
			request>uri replace REDACTED
			request>headers>Authorization replace REDACTED
			request>headers>Cookie replace REDACTED
			request>headers>X-Vercel-Proxy-Signature replace REDACTED
			request>headers>X-Vercel-Proxy-Signature-Ts replace REDACTED
			resp_headers>Location replace REDACTED
			resp_headers>Set-Cookie replace REDACTED
			wrap json
		}
	}

	@acme path /.well-known/acme-challenge/*
	handle @acme {
		root * /var/www/certbot
		file_server
	}

	handle {
		respond "TLS certificate provisioning in progress" 503
	}
}
