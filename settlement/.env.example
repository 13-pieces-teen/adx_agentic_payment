# === Injective EVM testnet (SETTLE-001) ===
# 复制为 .env 并填入。.env 绝不进 git / 不打包（见根 .gitignore）。

# 链参数（已知，一般不用改）
INJECTIVE_EVM_RPC=https://k8s.testnet.json-rpc.injective.network/
INJECTIVE_CHAIN_ID=1439

# USDC 合约地址 —— 由 check-env 探测确认后填入（先留空，脚本会尝试从 deployments.json 读）
USDC_ADDRESS=

# === 三个测试钱包（私钥，0x 开头，各自本地生成，切勿共享/提交）===
# 买方：持 USDC，签名付款（无需 INJ）
BUYER_PRIVATE_KEY=
# 卖方：收款地址即可（此处填私钥仅测试期方便，生产只需地址）
SELLER_PRIVATE_KEY=
# facilitator：充 INJ，代付 gas，唯一上链者
FACILITATOR_PRIVATE_KEY=
