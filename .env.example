# ADX Agent Arena — Environment Variables
# Copy to .env and fill in your values.

# Supabase (required for production mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase service key (for admin operations)
SUPABASE_SERVICE_KEY=

# Injective Network (for on-chain settlement)
INJECTIVE_RPC_URL=https://testnet.sentry.tm.injective.network:443
INJECTIVE_CHAIN_ID=injective-888

# Agent platform secret (for API key HMAC)
ADX_PLATFORM_SECRET=change-this-in-production

# Public web URL shown by the local Connector during device pairing
ADX_PUBLIC_APP_URL=http://localhost:3000

# Explicitly enables the unauthenticated, in-memory Connector demo control plane.
# Keep false on every shared or remotely reachable deployment. Production must
# provide real login plus tenant/object authorization before mounting the router.
ADX_CONNECTOR_UNSAFE_DEMO=false

# Next.js browser requests to the FastAPI service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Connector CLI enrollment API (the CLI also accepts --api-base)
ADX_API_BASE=http://localhost:8000
