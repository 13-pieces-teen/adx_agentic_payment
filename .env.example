# Arena 402 environment variables.
# Copy to .env and fill in deployment-specific values. Keep this example free
# of private keys, seed phrases, passwords, and access tokens.

APP_ENV=development

# Injective network used by the Python Arena services. The EVM settlement
# prototype has a separate example under agent-arena/settlement/.env.example.
INJECTIVE_NETWORK=testnet
INJECTIVE_RPC_URL=https://testnet.sentry.tm.injective.network:443
INJECTIVE_CHAIN_ID=injective-888

# User wallet read-only APIs. The backend never receives a wallet private key.
ADX_WALLET_RPC_URL=https://k8s.testnet.json-rpc.injective.network/
ADX_WALLET_EXPLORER_URL=https://testnet.blockscout.injective.network
ADX_ARENA_EXPLORER_TX_URL_TEMPLATE=https://testnet.blockscout.injective.network/tx/{txHash}
# Leave empty until the deployed Arena 402 token contracts are finalized.
ADX_ARENA402_G_TOKEN_ADDRESS=0xBF7B7268CE82d92BaC7a95a741F4003FE84e1884
ADX_ARENA402_G_TOKEN_DECIMALS=6
ADX_ARENA402_M_TOKEN_ADDRESS=
ADX_ARENA402_M_TOKEN_DECIMALS=6

# Agent platform secret used for API-key HMAC in authenticated deployments.
ADX_PLATFORM_SECRET=

# Public web URL shown by the local Connector during device pairing.
ADX_PUBLIC_APP_URL=http://localhost:3000

# Explicitly enables the unauthenticated, in-memory Connector demo control plane.
# Keep false on every shared or remotely reachable deployment.
ADX_CONNECTOR_UNSAFE_DEMO=false

# Mounts only the public, read-only Arena game API. Production deployments
# must also provide ADX_ARENA_CORE_DATABASE_URL.
ADX_ARENA_CORE_ENABLED=false

# Optional managed-local task transport rollout. Keep disabled until the
# production Connector service and local adx-connector both select MCP.
ADX_ARENA_MCP_ENABLED=false
ADX_ARENA_MCP_TOKEN_SECRET=
# Local Connector process setting; supported values are wss and mcp.
ADX_CONNECTOR_TASK_TRANSPORT=wss

# Founding 402 memorial eligibility and public status API. This is independent
# from the game wallet, PaymentMandate, and settlement paths.
ADX_ARENA_MEMORIAL_ENABLED=false

# Browser and local Connector API endpoints.
NEXT_PUBLIC_API_URL=http://localhost:8000
ADX_API_BASE=http://localhost:8000
